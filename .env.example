# Production uses a self-hosted Supabase API origin (not *.supabase.co).
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_PUBLIC_APP_URL=https://app.anttodo.com
# Optional build-time identity for the public instance manifest.
ANTTODO_INSTANCE_ID=00000000-0000-4000-8000-000000000001
# Public instance name used for self-hosted branding. The official service is shown as “AntTodo.com”
# in the service picker, while its page brand and browser tab title remain “蚂蚁清单”.
ANTTODO_INSTANCE_DISPLAY_NAME=AntTodo.com
# saas | onPremises. Independent deployments hide the login Slug field and
# read ANTTODO_INSTANCE_ENTERPRISE_SLUG from /.well-known/anttodo.json.
ANTTODO_DEPLOY_MODE=saas
# Optional default enterprise SSO entry included in /.well-known/anttodo.json.
# Required when ANTTODO_DEPLOY_MODE=onPremises.
# ANTTODO_INSTANCE_ENTERPRISE_SLUG=yucekj
# Required for `pnpm supabase:push` / deploy scripts that migrate production.
ANTTODO_SUPABASE_SELFHOST_SSH=supabase
ANTTODO_SUPABASE_SELFHOST_DOCKER_DIR=/home/ubuntu/projects/supabase/docker
# `pnpm deploy:web:yuce` reuses the SSH target above unless overridden.
# It also rsyncs `supabase/functions` into this docker directory and restarts
# the Edge Functions service.
# The remote deploy directory is auto-detected when this value is omitted.
# ANTTODO_YUCE_WEB_SSH=supabase
# ANTTODO_YUCE_WEB_DEPLOY_DIR=/home/ubuntu/projects/anttodo/deploy/ubuntu
ANTTODO_YUCE_WEB_URL=https://todo.yuce-tech.cn
# Workspace SSO URLs are `${VITE_PUBLIC_APP_URL}/team/{slug}`.
# Use ?demo=1 for a local product tour without an account.

ALIYUN_APIKEY=
ALIYUN_SECRETKEY=
ALIYUN_REGION=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SEND_SMS_HOOK_SECRETS=
# Optional: HK Edge Function forwards the SMS hook to Aliyun FC when
# dysmsapi.aliyuncs.com is unreachable from the host.
# ALIYUN_SMS_RELAY_URL=https://<fc-http-trigger>.fcapp.run
# ALIYUN_SMS_RELAY_BEARER=

# DeepSeek API key for AI smart formatting (Edge Function ai-task-format).
# Do not expose as VITE_*. Set on the Edge Function runtime / secrets manager.
DEEPSEEK_API_KEY=
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# HMAC secret for DingTalk SSO OAuth state (Edge Function dingtalk-sso).
SSO_STATE_SECRET=
# Public app origin used by Edge Functions for DingTalk callback URL.
PUBLIC_APP_URL=https://app.anttodo.com
# Server-only bootstrap mobile for the initial AntTodo app super admin.
# The Supabase startup bootstrap creates/promotes this phone idempotently.
init_app_admin_mobile=

# macOS OSS publish (`pnpm upload:mac:oss` / `pnpm deploy:mac`)
# and iOS TestFlight upload (`pnpm ios:testflight` / `pnpm deploy:ios`)
APPLE_API_KEY=/absolute/path/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Optional iOS overrides (defaults match the Xcode project)
# IOS_DEVELOPMENT_TEAM=U99DYL88T7
# IOS_BUNDLE_ID=com.anttodo.ios
# IOS_SCHEME=App
# Local "Apple Distribution" certificate required for IPA export.
# API Key needs Admin only for cloud signing; App Manager is enough for upload.

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
OSS_BUCKET=anttodo-yuce
OSS_REGION=cn-hangzhou
OSS_PREFIX=release
OSS_PUBLIC_BASE_URL=https://anttodo-yuce.oss-cn-hangzhou.aliyuncs.com
