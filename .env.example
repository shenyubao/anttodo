VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_PUBLIC_APP_URL=https://app.anttodo.com
# Workspace SSO URLs are `${VITE_PUBLIC_APP_URL}/team/{slug}`.
# Use ?demo=1 for a local product tour without an account.

ALIYUN_APIKEY=
ALIYUN_SECRETKEY=
ALIYUN_REGION=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SEND_SMS_HOOK_SECRETS=

# HMAC secret for DingTalk SSO OAuth state (Edge Function dingtalk-sso).
SSO_STATE_SECRET=
# Public app origin used by Edge Functions for DingTalk callback URL.
PUBLIC_APP_URL=https://app.anttodo.com
