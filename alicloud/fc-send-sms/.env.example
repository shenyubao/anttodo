# Copy production Edge Function values into Aliyun FC environment.
ALIYUN_APIKEY=
ALIYUN_SECRETKEY=
ALIYUN_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SEND_SMS_HOOK_SECRETS=v1,whsec_<base64-secret>

# Optional: shared secret for thin {url,headers} forward mode.
# Preferred production path is webhook forward + FC HTTP Bearer auth.
ALIYUN_SMS_RELAY_SECRET=
