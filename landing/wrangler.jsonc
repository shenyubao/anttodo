{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anttodo-landing",
  "main": "worker.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "anttodo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.anttodo.com",
      "custom_domain": true
    }
  ]
}
