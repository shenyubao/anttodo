{
  "name": "anttodo",
  "version": "1.0.202610212008",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "node scripts/free-port.mjs 5173 && vite --host 127.0.0.1",
    "dev:mac": "concurrently -k -n web,desktop -c blue,magenta \"pnpm dev:web\" \"pnpm dev:desktop\"",
    "dev:desktop": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc -b && vite build && pnpm --filter @anttodos/cli build",
    "build:web": "vite build",
    "ios:sync": "VITE_PUBLIC_APP_URL=https://app.anttodo.com pnpm build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "pnpm ios:sync && cap run ios",
    "ios:testflight": "node scripts/publish-ios-testflight.mjs",
    "deploy:ios": "pnpm ios:testflight",
    "docs:dev": "pnpm --filter docs start",
    "docs:build": "pnpm --filter docs build",
    "landing:dev": "pnpm --filter anttodo-landing dev",
    "landing:build": "pnpm --filter anttodo-landing build",
    "landing:test": "pnpm --filter anttodo-landing test",
    "bump:app-version": "node scripts/bump-app-version.mjs",
    "deploy:app": "pnpm bump:app-version && pnpm deploy:web",
    "deploy:web": "pnpm supabase:push && VITE_PUBLIC_APP_URL=https://app.anttodo.com pnpm build && wrangler deploy",
    "docker:web:build": "docker build -f deploy/ubuntu/Dockerfile -t anttodo-web:local .",
    "docker:web:test": "sh deploy/ubuntu/smoke-test.sh",
    "deploy:ubuntu": "sh deploy/ubuntu/deploy.sh",
    "deploy:web:yuce": "node scripts/deploy-yuce-web.mjs",
    "deploy:docs": "pnpm --filter docs run deploy",
    "deploy:landing": "pnpm --filter anttodo-landing run deploy",
    "mac:submit": "node scripts/mac-notarize-submit.mjs",
    "mac:list": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-anttodo-notarization} node scripts/mac-notarize-list.mjs",
    "mac:deploy": "node scripts/mac-deploy-after-notarize.mjs",
    "mac:all": "pnpm mac:submit && pnpm mac:deploy",
    "deploy:mac": "pnpm mac:all",
    "mac:signing:check": "node scripts/check-macos-signing.mjs",
    "package:mac": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-anttodo-notarization} sh -c 'pnpm mac:signing:check && pnpm build && electron-builder --mac dmg zip && node scripts/verify-macos-package.mjs arm64'",
    "package:mac:all": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-anttodo-notarization} sh -c 'pnpm mac:signing:check && pnpm build && electron-builder --mac dmg zip --arm64 --x64 && node scripts/verify-macos-package.mjs arm64 x64'",
    "upload:mac:oss": "node scripts/publish-mac-oss.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false && pnpm --filter @anttodos/cli typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start --workdir .",
    "supabase:reset": "supabase db reset --local --workdir .",
    "supabase:push": "node scripts/supabase-db-push.mjs",
    "supabase:test": "supabase test db --workdir .",
    "cli:build": "pnpm --filter @anttodos/cli build",
    "cli:run": "pnpm --silent --filter @anttodos/cli build && node cli/dist/index.js",
    "cli:test": "pnpm --filter @anttodos/cli test",
    "cli:test:integration": "pnpm --filter @anttodos/cli test:integration",
    "cli:test:browser": "pnpm --filter @anttodos/cli test:browser",
    "cli:pack": "pnpm --filter @anttodos/cli pack:check",
    "cli:verify": "pnpm --filter @anttodos/cli typecheck && pnpm --filter @anttodos/cli test && pnpm --filter @anttodos/cli pack:check",
    "cli:oauth:configure": "node scripts/configure-cli-oauth.mjs",
    "bump:cli-version": "node scripts/bump-app-version.mjs cli/package.json",
    "deploy:cli": "pnpm bump:cli-version && pnpm cli:verify && node scripts/publish-cli.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "8.2.1",
    "@dagrejs/dagre": "3.0.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/react": "7.0.2",
    "@mdxeditor/editor": "4.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.2",
    "chinese-days": "^1.5.9",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "electron-updater": "6.6.2",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.26.0",
    "node-html-markdown": "2.0.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "temporal-polyfill": "1.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "ali-oss": "^6.23.0",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0",
    "wrangler": "^4.115.0"
  },
  "build": {
    "appId": "com.anttodo.desktop",
    "productName": "蚂蚁清单",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "forceCodeSigning": true,
    "afterSign": "scripts/notarize-macos.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "protocols": [
      {
        "name": "蚂蚁清单",
        "schemes": [
          "anttodo"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/app-update.yml",
          "to": "app-update.yml"
        }
      ],
      "signIgnore": "\\.pak$",
      "extendInfo": {
        "CFBundleDisplayName": "蚂蚁清单",
        "CFBundleName": "蚂蚁清单"
      },
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "AntTodo-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "notarize": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://anttodo-yuce.oss-cn-hangzhou.aliyuncs.com/release/macos"
    }
  }
}
