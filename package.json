{
  "name": "anttodo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "node scripts/free-port.mjs 5173 && vite --host 127.0.0.1",
    "dev:mac": "concurrently -k -n web,desktop -c blue,magenta \"pnpm dev:web\" \"pnpm dev:desktop\"",
    "dev:desktop": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "deploy:web": "VITE_PUBLIC_APP_URL=https://app.anttodo.com pnpm build && wrangler deploy",
    "docs:dev": "pnpm --filter docs start",
    "docs:build": "pnpm --filter docs build",
    "deploy:docs": "pnpm --filter docs run deploy",
    "package:mac": "pnpm build && electron-builder --mac dmg zip",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start --workdir .",
    "supabase:reset": "supabase db reset --local --workdir .",
    "supabase:test": "supabase test db --workdir ."
  },
  "dependencies": {
    "@dagrejs/dagre": "3.0.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/react": "7.0.2",
    "@mdxeditor/editor": "4.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@xyflow/react": "12.11.2",
    "chinese-days": "^1.5.9",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "1.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0",
    "wrangler": "^4.115.0"
  },
  "build": {
    "appId": "com.anttodo.desktop",
    "productName": "AntTodo",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "identity": null
    }
  }
}
