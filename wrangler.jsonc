{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anttodo-app",
  "main": "worker.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/open/v1/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.anttodo.com",
      "custom_domain": true
    }
  ]
}
